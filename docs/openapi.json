  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "additionalProperties": false
      },
      "SystemStatus": {
        "type": "object",
        "properties": {
          "application_version": {
            "type": "string"
          },
          "api_version": {
            "const": "window-v1"
          },
          "architecture_version": {
            "const": "kidra-reference/2"
          },
          "uptime_ms": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "const": "ready"
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "available",
                "unimplemented",
                "unavailable"
              ]
            }
          }
        },
        "required": [
          "application_version",
          "api_version",
          "architecture_version",
          "uptime_ms",
          "status",
          "capabilities"
        ],
        "additionalProperties": false
      },
      "CreateInferenceSession": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "max_windows": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "model_id",
          "max_windows",
          "seed"
        ],
        "additionalProperties": false
      },
      "CreateTrainingJob": {
        "type": "object",
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "full_parameter_sft"
            ]
          }
        },
        "required": [
          "dataset_id",
          "model_id",
          "mode"
        ],
        "additionalProperties": false
      },
      "CreateAgentTask": {
        "type": "object",
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "project_id",
          "instructions",
          "permissions"
        ],
        "additionalProperties": false
      },
      "Devices": {
        "type": "object",
        "properties": {
          "devices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "const": "cpu"
                },
                "architecture": {
                  "type": "string"
                },
                "os": {
                  "type": "string"
                },
                "available_parallelism": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                }
              },
              "required": [
                "id",
                "kind",
                "architecture",
                "os",
                "available_parallelism"
              ],
              "additionalProperties": false
            }
          },
          "cuda_discovery": {
            "const": "unavailable"
          }
        },
        "required": [
          "devices",
          "cuda_discovery"
        ],
        "additionalProperties": false
      },
      "Resources": {
        "type": "object",
        "properties": {
          "scheduler": {
            "const": "unimplemented"
          },
          "reservations": {
            "type": "array",
            "maxItems": 0
          },
          "memory_measurements": {
            "type": "null"
          }
        },
        "required": [
          "scheduler",
          "reservations",
          "memory_measurements"
        ],
        "additionalProperties": false
      },
      "Models": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "maxItems": 0
          },
          "model_loading": {
            "const": "unimplemented"
          }
        },
        "required": [
          "models",
          "model_loading"
        ],
        "additionalProperties": false
      },
      "TinyGenerate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "max_tokens"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "ASCII bytes only; ascii/1 experiment tokenizer"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          }
        }
      },
      "TinyTrain": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      }
    },
