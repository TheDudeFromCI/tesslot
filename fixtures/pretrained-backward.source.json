{
  "schema-version": "1.0",
  "id": "pretrained-backward-two-window",
  "uuid": "c0ffee24-1234-5678-1234-567812345678",
  "tick-policy": "external-first",
  "defaults": {"window-headers": false, "implicit-noop-loss-weight": 0.0},
