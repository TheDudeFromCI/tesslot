    ],
    "1": [{"op": "generate", "window": "answer", "content": "A", "loss": {"weight": 1.0}}],
    "2": [
      {"op": "generate", "window": "context", "content": "<|kidra_eos|>", "loss": {"mask": "exclude"}},
      {"op": "generate", "window": "answer", "content": "<|kidra_eos|>", "loss": {"mask": "exclude"}}
    ]
  }
