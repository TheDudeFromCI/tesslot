      "name": "file_patch",
      "description": "Apply exact text edits atomically. Supply old/new or an edits array of old/new pairs, applied in order. Each old must match exactly once. Optional expected_version detects stale edits.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "old": {
            "type": "string"
          },
          "new": {
            "type": "string"
          },
          "expected_version": {
            "type": "string"
          },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "old": {
                  "type": "string",
                  "minLength": 1
                },
                "new": {
                  "type": "string"
                }
              },
              "required": [
                "old",
                "new"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path"
        ],
        "oneOf": [
          {
            "required": [
              "old",
              "new"
            ],
            "not": {
              "required": [
                "edits"
              ]
            }
          },
          {
            "required": [
              "edits"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "old"
                  ]
                },
                {
                  "required": [
                    "new"
                  ]
                }
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
